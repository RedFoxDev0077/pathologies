# ================================
# ANALYTICS (frontend, build-time)
# ================================
# NOTE: every VITE_* value below is compiled into the public JS bundle and is
# visible in page source. They are configuration, NOT secrets. In GitHub they
# belong in repository *Variables* (Settings → Secrets and variables →
# Variables), not Secrets.

# GA4 measurement id. Without it there is no funnel reporting at all — only the
# Google Ads tag, which cannot answer "where do users drop out?".
# Google Analytics → Admin → Data streams → your web stream.
VITE_GA4_ID=G-XXXXXXXXXX

# Google Ads conversion labels, one per funnel step you want to bid on.
# Format: AW-17995643190/XXXXXXXXXXXXXXXXX
# Get them from Google Ads → Goals → Conversions → New conversion action →
# Website → set up manually → "Use Google tag". Each action gives one label.
#
# Any label left blank simply disables the Ads conversion ping for that step;
# the plain GA4 event is still sent, so no data is lost while they are pending.
VITE_ADS_CONV_BEGIN_ANALYSIS=
VITE_ADS_CONV_COMPLETE_ANALYSIS=
VITE_ADS_CONV_UPGRADE_400=
VITE_ADS_CONV_UPGRADE_950=
VITE_ADS_CONV_BEGIN_CHECKOUT=
VITE_ADS_CONV_PURCHASE=

# Fallback conversion value in EUR, used only when the backend does not report
# the amount actually charged. Should equal the report's gross price (currently
# 484 = 400 EUR + 21% VAT). Leave blank to send no value rather than a wrong one
# (a wrong value trains Ads bidding on bad data).
VITE_REPORT_VALUE_EUR=484

# API base. Defaults to the production API when unset — set this in local dev to
# avoid pointing your dev server at live customer data.
# VITE_API_URL=http://localhost:3001/api
